# Template only: Django reads backend/.env, not this file.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MAX_LEAVE_DAYS=30

# Render demo setup only. Set a private password in the Render environment.
# DEMO_PASSWORD=

# Optional initial admin setup: copy these keys to backend/.env and run
# `python manage.py seed_admin`. This password does not update an existing
# account; use `python manage.py changepassword <email>` to change that account.
SEED_ADMIN_NAME="Admin User"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-random-password"
